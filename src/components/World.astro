---
---
<!-- Fixed viewport -->
<div class="game-viewport" id="viewport">

  <!-- Sky -->
  <div class="sky" id="sky"></div>

  <!-- Stars -->
  <div class="stars" id="stars">
    {Array.from({ length: 40 }).map((_, i) => (
      <span class="star" style={`left:${Math.random()*100}%;top:${Math.random()*60}%;animation-delay:${Math.random()*3}s;opacity:${0.3+Math.random()*0.7}`}></span>
    ))}
  </div>

  <!-- Far parallax: mountains -->
  <div class="parallax-far" id="pxFar">
    <svg class="mountains" viewBox="0 0 6000 300" preserveAspectRatio="none">
      <path d="M0,300 L0,200 L200,120 L400,180 L600,80 L800,160 L1000,60 L1200,140 L1400,100 L1600,170 L1800,50 L2000,130 L2200,90 L2400,160 L2600,70 L2800,150 L3000,40 L3200,120 L3400,80 L3600,150 L3800,60 L4000,140 L4200,100 L4400,170 L4600,50 L4800,130 L5000,90 L5200,160 L5400,70 L5600,120 L5800,80 L6000,150 L6000,300Z" fill="rgba(15,15,26,0.5)"/>
      <path d="M0,300 L0,220 L300,160 L500,200 L700,140 L900,190 L1100,120 L1300,180 L1500,130 L1700,200 L1900,110 L2100,170 L2300,140 L2500,190 L2700,100 L2900,160 L3100,120 L3300,180 L3500,130 L3700,200 L3900,110 L4100,170 L4300,140 L4500,190 L4700,100 L4900,160 L5100,120 L5300,180 L5500,130 L5700,170 L6000,200 L6000,300Z" fill="rgba(15,15,26,0.35)"/>
    </svg>
  </div>

  <!-- Mid parallax: city silhouette -->
  <div class="parallax-mid" id="pxMid">
    <svg class="cityscape" viewBox="0 0 8000 250" preserveAspectRatio="none">
      <rect x="200" y="130" width="60" height="120" fill="rgba(15,15,26,0.6)"/>
      <rect x="280" y="100" width="40" height="150" fill="rgba(15,15,26,0.55)"/>
      <rect x="340" y="150" width="70" height="100" fill="rgba(15,15,26,0.6)"/>
      <rect x="700" y="110" width="50" height="140" fill="rgba(15,15,26,0.55)"/>
      <rect x="770" y="80" width="35" height="170" fill="rgba(15,15,26,0.6)"/>
      <rect x="1200" y="120" width="80" height="130" fill="rgba(15,15,26,0.55)"/>
      <rect x="1300" y="90" width="45" height="160" fill="rgba(15,15,26,0.6)"/>
      <rect x="1800" y="100" width="60" height="150" fill="rgba(15,15,26,0.55)"/>
      <rect x="1880" y="130" width="50" height="120" fill="rgba(15,15,26,0.6)"/>
      <rect x="2400" y="80" width="70" height="170" fill="rgba(15,15,26,0.55)"/>
      <rect x="2500" y="120" width="40" height="130" fill="rgba(15,15,26,0.6)"/>
      <rect x="3000" y="100" width="55" height="150" fill="rgba(15,15,26,0.55)"/>
      <rect x="3100" y="140" width="65" height="110" fill="rgba(15,15,26,0.6)"/>
      <rect x="3600" y="90" width="50" height="160" fill="rgba(15,15,26,0.55)"/>
      <rect x="4200" y="110" width="60" height="140" fill="rgba(15,15,26,0.6)"/>
      <rect x="4800" y="100" width="45" height="150" fill="rgba(15,15,26,0.55)"/>
      <rect x="5400" y="120" width="70" height="130" fill="rgba(15,15,26,0.6)"/>
      <rect x="6000" y="90" width="55" height="160" fill="rgba(15,15,26,0.55)"/>
      <rect x="6600" y="130" width="60" height="120" fill="rgba(15,15,26,0.6)"/>
      <rect x="7200" y="100" width="50" height="150" fill="rgba(15,15,26,0.55)"/>
    </svg>
  </div>

  <!-- World layer -->
  <div class="world-layer" id="world">

    <!-- Ground -->
    <div class="ground"></div>
    <div class="ground-line"></div>

    <!-- ═══════ SECTION LABELS ═══════ -->
    <div class="section-label" style="left: 1500px">
      <span class="sl-title">Origins</span>
      <span class="sl-sub">Curiosity turned into code</span>
    </div>
    <div class="section-label" style="left: 3450px">
      <span class="sl-title">Corporate Years</span>
      <span class="sl-sub">Learning to build at scale</span>
    </div>
    <div class="section-label" style="left: 5550px">
      <span class="sl-title">Founder Arc</span>
      <span class="sl-sub">Building, breaking, learning</span>
    </div>
    <div class="section-label" style="left: 7300px">
      <span class="sl-title">Now</span>
      <span class="sl-sub">Everything connects here</span>
    </div>
    <div class="section-label" style="left: 9200px">
      <span class="sl-title">Published Author</span>
      <span class="sl-sub">Oh, he also wrote a book</span>
    </div>
    <div class="section-label" style="left: 9850px">
      <span class="sl-title">Beyond the Code</span>
      <span class="sl-sub">The human behind the data</span>
    </div>

    <!-- ═══════ TIMELINE RAIL ═══════ -->
    <div class="timeline-rail">
      <div class="tl-line"></div>
      <div class="tl-marker" style="left: 2400px"><span class="tl-year">2017</span><div class="tl-dot"></div></div>
      <div class="tl-marker" style="left: 3100px"><span class="tl-year">2021</span><div class="tl-dot"></div></div>
      <div class="tl-marker" style="left: 3800px"><span class="tl-year">2022</span><div class="tl-dot"></div></div>
      <div class="tl-marker" style="left: 4500px"><span class="tl-year">2023</span><div class="tl-dot"></div></div>
      <div class="tl-marker" style="left: 5200px"><span class="tl-year">2024</span><div class="tl-dot"></div></div>
      <div class="tl-marker" style="left: 5900px"><span class="tl-year">2025</span><div class="tl-dot"></div></div>
      <div class="tl-marker accent-marker" style="left: 7300px"><span class="tl-year">2026</span><div class="tl-dot"></div></div>
      <div class="tl-marker" style="left: 10600px"><span class="tl-year">NOW</span><div class="tl-dot"></div></div>
    </div>

    <!-- ═══════ HERO ═══════ -->
    <div class="zone zone-hero" style="left: 100px">
      <div class="hero-title">
        <p class="hero-pre">Interactive Portfolio of</p>
        <h1 class="hero-name">Ayush<br/><span class="accent">Saxena</span></h1>
        <p class="hero-sub">Builder · Analyst · Author</p>
      </div>
      <div class="signpost" style="left: 700px">
        <div class="sign-arrow">Scroll to explore →</div>
        <div class="sign-pole"></div>
      </div>
    </div>

    <!-- Scenery -->
    <div class="tree" style="left: 500px"><svg viewBox="0 0 40 60"><circle cx="20" cy="15" r="15" fill="rgba(15,15,26,0.7)"/><rect x="18" y="28" width="4" height="32" fill="rgba(15,15,26,0.8)"/></svg></div>
    <div class="tree" style="left: 900px"><svg viewBox="0 0 40 50"><circle cx="20" cy="12" r="12" fill="rgba(15,15,26,0.65)"/><rect x="18" y="22" width="4" height="28" fill="rgba(15,15,26,0.75)"/></svg></div>

    <!-- ═══════ CHILDHOOD ═══════ -->
    <div class="zone" style="left: 1200px">
      <div class="office">
        <svg viewBox="-30 0 191 130"><rect x="15" y="15" width="100" height="100" rx="8" fill="#161630" stroke="rgba(108,51,255,0.25)" stroke-width="0.8"/><rect x="30" y="35" width="30" height="20" rx="3" fill="rgba(108,51,255,0.2)"/><rect x="65" y="35" width="30" height="20" rx="3" fill="rgba(74,158,255,0.2)"/><rect x="30" y="60" width="30" height="20" rx="3" fill="rgba(74,158,255,0.2)"/><rect x="65" y="60" width="30" height="20" rx="3" fill="rgba(108,51,255,0.2)"/><rect x="45" y="90" width="40" height="15" rx="6" fill="rgba(244,168,67,0.2)" stroke="rgba(244,168,67,0.3)" stroke-width="0.5"/><circle cx="55" cy="97" r="2" fill="var(--accent)" opacity="0.5"/><circle cx="65" cy="97" r="2" fill="var(--accent)" opacity="0.5"/><circle cx="75" cy="97" r="2" fill="var(--accent)" opacity="0.5"/></svg>
        <div class="office-label">
          <span class="ol-name">Childhood</span>
          <span class="ol-desc">Fascinated by video games. How do they work?</span>
        </div>
      </div>
    </div>

    <div class="lamp" style="left: 1600px"><svg viewBox="0 0 20 80"><rect x="9" y="10" width="2" height="70" fill="rgba(244,168,67,0.3)"/><circle cx="10" cy="8" r="5" fill="var(--accent)" opacity="0.8"/><circle cx="10" cy="8" r="15" fill="var(--accent)" opacity="0.08"/></svg></div>

    <!-- ═══════ CLASS 8 ═══════ -->
    <div class="zone" style="left: 1800px">
      <div class="office">
        <svg viewBox="-30 0 191 130"><rect x="10" y="10" width="110" height="80" rx="4" fill="#161630" stroke="rgba(16,217,160,0.25)" stroke-width="0.8"/><rect x="18" y="18" width="94" height="60" rx="2" fill="#0a0a18"/><text x="65" y="42" text-anchor="middle" fill="rgba(16,217,160,0.6)" font-size="8" font-family="monospace">&lt;/game&gt;</text><text x="65" y="56" text-anchor="middle" fill="rgba(74,158,255,0.5)" font-size="7" font-family="monospace">render()</text><rect x="30" y="95" width="70" height="8" rx="3" fill="rgba(244,168,67,0.15)"/></svg>
        <div class="office-label">
          <span class="ol-name">Class 8</span>
          <span class="ol-desc">Built a graphic game from scratch</span>
        </div>
      </div>
    </div>

    <div class="tree" style="left: 2150px"><svg viewBox="0 0 40 60"><circle cx="20" cy="15" r="15" fill="rgba(15,15,26,0.7)"/><rect x="18" y="28" width="4" height="32" fill="rgba(15,15,26,0.8)"/></svg></div>

    <!-- ═══════ JIIT NOIDA — BTech CS ═══════ -->
    <div class="zone" style="left: 2400px">
      <div class="building">
        <div class="bldg-logo"><img src="/assets/logos/jiit.png" alt="JIIT" class="logo-img" /></div>
        <svg viewBox="-22 0 264 180" class="campus-svg">
          <rect x="20" y="40" width="180" height="140" rx="3" fill="#161630"/>
          <rect x="20" y="40" width="180" height="140" rx="3" fill="none" stroke="rgba(244,168,67,0.2)" stroke-width="0.8"/>
          <rect x="20" y="40" width="180" height="8" fill="rgba(244,168,67,0.25)" rx="3"/>
          <rect x="80" y="10" width="60" height="30" rx="2" fill="#1a1a38"/>
          <rect x="80" y="10" width="60" height="30" rx="2" fill="none" stroke="rgba(244,168,67,0.2)" stroke-width="0.6"/>
          <rect x="80" y="10" width="60" height="6" fill="rgba(244,168,67,0.2)" rx="2"/>
          <line x1="110" y1="0" x2="110" y2="10" stroke="var(--accent)" stroke-width="1.5" opacity="0.6"/>
          <circle cx="110" cy="0" r="2" fill="var(--accent)" opacity="0.8"/>
          <rect x="90" y="22" width="10" height="12" rx="1" fill="rgba(74,158,255,0.35)"/>
          <rect x="105" y="22" width="10" height="12" rx="1" fill="rgba(74,158,255,0.3)"/>
          <rect x="120" y="22" width="10" height="12" rx="1" fill="rgba(74,158,255,0.35)"/>
          <rect x="32" y="56" width="22" height="28" rx="2" fill="rgba(74,158,255,0.25)"/>
          <rect x="62" y="56" width="22" height="28" rx="2" fill="rgba(244,168,67,0.3)"/>
          <rect x="92" y="56" width="22" height="28" rx="2" fill="rgba(74,158,255,0.2)"/>
          <rect x="122" y="56" width="22" height="28" rx="2" fill="rgba(244,168,67,0.25)"/>
          <rect x="152" y="56" width="22" height="28" rx="2" fill="rgba(74,158,255,0.25)"/>
          <line x1="20" y1="92" x2="200" y2="92" stroke="rgba(244,168,67,0.12)" stroke-width="0.5"/>
          <rect x="32" y="100" width="22" height="28" rx="2" fill="rgba(244,168,67,0.2)"/>
          <rect x="62" y="100" width="22" height="28" rx="2" fill="rgba(74,158,255,0.25)"/>
          <rect x="92" y="100" width="22" height="28" rx="2" fill="rgba(244,168,67,0.25)"/>
          <rect x="122" y="100" width="22" height="28" rx="2" fill="rgba(74,158,255,0.2)"/>
          <rect x="152" y="100" width="22" height="28" rx="2" fill="rgba(244,168,67,0.2)"/>
          <rect x="88" y="145" width="44" height="35" rx="3" fill="rgba(244,168,67,0.35)"/>
          <rect x="88" y="145" width="44" height="35" rx="3" fill="none" stroke="var(--accent)" stroke-width="0.5" opacity="0.5"/>
        </svg>
        <div class="building-label">
          <span class="bl-title">JIIT Noida</span>
          <span class="bl-sub">BTech, Computer Science (2017-2021)</span>
        </div>
      </div>
    </div>

    <div class="lamp" style="left: 2900px"><svg viewBox="0 0 20 80"><rect x="9" y="10" width="2" height="70" fill="rgba(244,168,67,0.3)"/><circle cx="10" cy="8" r="5" fill="var(--accent)" opacity="0.8"/><circle cx="10" cy="8" r="15" fill="var(--accent)" opacity="0.08"/></svg></div>

    <!-- ═══════ COGNIZANT — 2021 ═══════ -->
    <div class="zone" style="left: 3100px">
      <div class="office">
        <div class="bldg-logo"><img src="/assets/logos/cognizant.png" alt="Cognizant" class="logo-img" /></div>
        <div class="office-building"><svg viewBox="-21 0 162 110"><rect x="5" y="15" width="110" height="95" rx="3" fill="#161630" stroke="rgba(244,168,67,0.15)" stroke-width="0.6"/><rect x="5" y="15" width="110" height="8" fill="rgba(74,158,255,0.2)" rx="3"/><rect x="18" y="35" width="18" height="20" rx="2" fill="rgba(74,158,255,0.2)"/><rect x="46" y="35" width="18" height="20" rx="2" fill="rgba(74,158,255,0.15)"/><rect x="74" y="35" width="18" height="20" rx="2" fill="rgba(74,158,255,0.2)"/><rect x="18" y="65" width="18" height="20" rx="2" fill="rgba(74,158,255,0.12)"/><rect x="46" y="65" width="18" height="20" rx="2" fill="rgba(74,158,255,0.18)"/><rect x="74" y="65" width="18" height="20" rx="2" fill="rgba(74,158,255,0.12)"/><rect x="44" y="92" width="24" height="18" rx="2" fill="rgba(244,168,67,0.3)"/></svg></div>
        <div class="office-label">
          <span class="ol-name">Cognizant</span>
          <span class="ol-desc">Cut regression testing by 98%</span>
        </div>
      </div>
    </div>

    <!-- ═══════ TIGER ANALYTICS — 2022 ═══════ -->
    <div class="zone" style="left: 3800px">
      <div class="office">
        <div class="bldg-logo"><img src="/assets/logos/tiger-analytics.webp" alt="Tiger Analytics" class="logo-img" /></div>
        <div class="office-building"><svg viewBox="-30 0 191 130"><rect x="5" y="10" width="120" height="120" rx="3" fill="#161630" stroke="rgba(244,168,67,0.15)" stroke-width="0.6"/><rect x="5" y="10" width="120" height="8" fill="rgba(244,168,67,0.2)" rx="3"/><rect x="18" y="28" width="20" height="24" rx="2" fill="rgba(244,168,67,0.2)"/><rect x="50" y="28" width="20" height="24" rx="2" fill="rgba(244,168,67,0.15)"/><rect x="82" y="28" width="20" height="24" rx="2" fill="rgba(244,168,67,0.2)"/><rect x="18" y="62" width="20" height="24" rx="2" fill="rgba(244,168,67,0.12)"/><rect x="50" y="62" width="20" height="24" rx="2" fill="rgba(244,168,67,0.18)"/><rect x="82" y="62" width="20" height="24" rx="2" fill="rgba(244,168,67,0.12)"/><rect x="18" y="96" width="20" height="18" rx="2" fill="rgba(244,168,67,0.1)"/><rect x="50" y="96" width="20" height="18" rx="2" fill="rgba(244,168,67,0.15)"/><rect x="82" y="96" width="20" height="18" rx="2" fill="rgba(244,168,67,0.1)"/></svg></div>
        <div class="office-label">
          <span class="ol-name">Tiger Analytics</span>
          <span class="ol-desc">Supply chain analytics, EMEA & NA</span>
        </div>
      </div>
    </div>

    <div class="tree" style="left: 4200px"><svg viewBox="0 0 40 60"><circle cx="20" cy="15" r="15" fill="rgba(15,15,26,0.7)"/><rect x="18" y="28" width="4" height="32" fill="rgba(15,15,26,0.8)"/></svg></div>

    <!-- ═══════ AI TRAINER — 2023 ═══════ -->
    <div class="zone" style="left: 4500px">
      <div class="office">
        <div class="office-building"><svg viewBox="-24 0 147 100"><rect x="5" y="10" width="90" height="90" rx="3" fill="#161630" stroke="rgba(108,51,255,0.2)" stroke-width="0.6"/><rect x="5" y="10" width="90" height="8" fill="rgba(108,51,255,0.2)" rx="3"/><rect x="18" y="30" width="16" height="18" rx="2" fill="rgba(108,51,255,0.2)"/><rect x="42" y="30" width="16" height="18" rx="2" fill="rgba(108,51,255,0.15)"/><rect x="66" y="30" width="16" height="18" rx="2" fill="rgba(108,51,255,0.2)"/><rect x="18" y="55" width="16" height="18" rx="2" fill="rgba(108,51,255,0.12)"/><rect x="42" y="55" width="16" height="18" rx="2" fill="rgba(108,51,255,0.18)"/><rect x="66" y="55" width="16" height="18" rx="2" fill="rgba(108,51,255,0.12)"/><rect x="35" y="80" width="30" height="15" rx="2" fill="rgba(244,168,67,0.3)"/></svg></div>
        <div class="office-label">
          <span class="ol-name">AI Trainer</span>
          <span class="ol-desc">Outlier / Deccan AI</span>
        </div>
      </div>
    </div>

    <div class="lamp" style="left: 4950px"><svg viewBox="0 0 20 80"><rect x="9" y="10" width="2" height="70" fill="rgba(244,168,67,0.3)"/><circle cx="10" cy="8" r="5" fill="var(--accent)" opacity="0.8"/><circle cx="10" cy="8" r="15" fill="var(--accent)" opacity="0.08"/></svg></div>

    <!-- ═══════ PROFIT PLUG — 2024 ═══════ -->
    <div class="zone" style="left: 5200px">
      <div class="office">
        <div class="bldg-logo"><img src="/assets/logos/profit-plug.png" alt="Profit Plug" class="logo-img" /></div>
        <div class="office-building"><svg viewBox="-24 0 147 100"><rect x="5" y="15" width="90" height="85" rx="3" fill="#161630" stroke="rgba(244,168,67,0.15)" stroke-width="0.6"/><rect x="5" y="15" width="90" height="8" fill="rgba(16,217,160,0.2)" rx="3"/><rect x="18" y="35" width="16" height="18" rx="2" fill="rgba(16,217,160,0.2)"/><rect x="42" y="35" width="16" height="18" rx="2" fill="rgba(16,217,160,0.15)"/><rect x="66" y="35" width="16" height="18" rx="2" fill="rgba(16,217,160,0.2)"/><rect x="18" y="62" width="16" height="18" rx="2" fill="rgba(16,217,160,0.12)"/><rect x="42" y="62" width="16" height="18" rx="2" fill="rgba(16,217,160,0.18)"/><rect x="66" y="62" width="16" height="18" rx="2" fill="rgba(16,217,160,0.12)"/><rect x="36" y="85" width="28" height="15" rx="2" fill="rgba(244,168,67,0.3)"/></svg></div>
        <div class="office-label">
          <span class="ol-name">Profit Plug</span>
          <span class="ol-desc">CAC ↓28%, CVR 1.6→2.7%</span>
        </div>
      </div>
    </div>

    <!-- ═══════ ARISVA — 2025 ═══════ -->
    <div class="zone" style="left: 5900px">
      <div class="shop">
        <div class="bldg-logo"><img src="/assets/logos/arisva.png" alt="Arisva" class="logo-img" /></div>
        <svg viewBox="0 -14 240 164" class="shop-svg">
          <rect x="10" y="30" width="220" height="120" rx="3" fill="#161630" stroke="rgba(244,168,67,0.15)" stroke-width="0.6"/>
          <polygon points="0,35 120,0 240,35" fill="#1a1a38" stroke="var(--accent)" stroke-width="0.8" opacity="0.6"/>
          <text x="120" y="25" text-anchor="middle" fill="var(--accent)" font-size="12" font-family="var(--font-sans)" font-weight="600">ARISVA</text>
          <rect x="25" y="50" width="30" height="45" rx="3" fill="rgba(244,168,67,0.12)"/>
          <rect x="65" y="50" width="30" height="45" rx="3" fill="rgba(244,168,67,0.15)"/>
          <rect x="105" y="50" width="30" height="45" rx="3" fill="rgba(244,168,67,0.12)"/>
          <rect x="145" y="50" width="30" height="45" rx="3" fill="rgba(244,168,67,0.15)"/>
          <rect x="185" y="50" width="30" height="45" rx="3" fill="rgba(244,168,67,0.12)"/>
          <!-- Arisva product boxes in windows -->
          <defs>
            <clipPath id="w1"><rect x="27" y="52" width="26" height="40" rx="2"/></clipPath>
            <clipPath id="w2"><rect x="67" y="52" width="26" height="40" rx="2"/></clipPath>
            <clipPath id="w3"><rect x="107" y="52" width="26" height="40" rx="2"/></clipPath>
            <clipPath id="w4"><rect x="147" y="52" width="26" height="40" rx="2"/></clipPath>
            <clipPath id="w5"><rect x="187" y="52" width="26" height="40" rx="2"/></clipPath>
          </defs>
