---
const scenes = [
  {
    img: '/assets/avatar-gardening.jpg',
    title: 'Gardening',
    desc: 'Growing things from the ground. A practice in patience — watching something emerge slowly, on its own schedule.',
    align: 'left',
  },
  {
    img: '/assets/avatar-shiv.jpg',
    title: 'Lord Shiv',
    desc: 'The destroyer and transformer. The constant through everything. In kurta and prayer, the noise goes quiet.',
    align: 'right',
  },
  {
    img: '/assets/avatar-trekking.jpg',
    title: 'Trekking',
    desc: 'Mountains, trails, and the clarity that comes at altitude. Every summit is earned one step at a time.',
    align: 'left',
  },
  {
    img: '/assets/avatar-reading.jpg',
    title: 'Reading',
    desc: 'Hindu epics, mythology, and the hidden science in ancient stories. How consciousness, cosmology, and nature were encoded centuries ago.',
    align: 'right',
  },
];
---
<section class="section beyond" id="book">
  <div class="container">
    <span class="section-label reveal">Beyond Work</span>
    <h2 class="section-title reveal stagger-1">The other side</h2>
    <div class="divider reveal stagger-2"></div>

    <div class="book-section reveal">
      <div class="book-cover-wrap">
        <img src="/assets/book-cover.jpg" alt="Eleven Seconds — Fifteen Stages of Love, Told Through Fifteen Old Songs by Ayush Saxena" class="book-cover" />
        <div class="book-glow"></div>
      </div>
      <div class="book-info">
        <span class="book-badge">Published Author</span>
        <h3 class="book-title">Eleven Seconds</h3>
        <p class="book-subtitle">Fifteen Stages of Love, Told Through Fifteen Old Songs</p>
        <p class="book-desc">
          A book that maps the arc of love through the lens of music —
          fifteen old songs, each marking a stage from first recognition to letting go.
          Part memoir, part meditation, entirely human.
        </p>
      </div>
    </div>
  </div>

  <!-- Avatar life scenes -->
  <div class="life-scenes">
    {scenes.map((scene, i) => (
      <div class={`scene scene-${scene.align}`} data-scene={i}>
        <div class="scene-image-wrap">
          <div class="scene-image-inner">
            <img src={scene.img} alt={`Ayush — ${scene.title}`} class="scene-image" loading="lazy" />
          </div>
          <div class="scene-vignette"></div>
        </div>
        <div class="scene-content">
          <span class="scene-number">0{i + 1}</span>
          <h3 class="scene-title">{scene.title}</h3>
          <p class="scene-desc">{scene.desc}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="container">
    <p class="beyond-note reveal">
      <em>The myth-science connection fascinates me — how ancient texts encoded observations
      about consciousness, cosmology, and nature centuries before modern frameworks arrived
      at the same conclusions through different paths.</em>
    </p>
  </div>
</section>

<style>
  .beyond {
    background: linear-gradient(180deg, var(--bg-elevated) 0%, var(--bg-deep) 100%);
  }
  .book-section {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 48px;
    align-items: center;
    margin-bottom: 64px;
    padding: 40px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 24px;
    position: relative;
    overflow: hidden;
  }
  .book-cover-wrap {
    position: relative;
  }
  .book-cover {
    width: 100%;
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    transition: transform 0.4s;
  }
  .book-section:hover .book-cover {
    transform: translateY(-8px) rotate(-1deg);
  }
  .book-glow {
    position: absolute;
    bottom: -20px;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 40px;
    background: var(--accent);
    filter: blur(40px);
    opacity: 0.15;
  }
  .book-badge {
    display: inline-block;
    padding: 4px 12px;
    background: var(--accent-subtle);
    border: 1px solid var(--border-accent);
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .book-title {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 400;
    font-style: italic;
    color: var(--text-primary);
    margin-bottom: 8px;
  }
  .book-subtitle {
    font-size: 1rem;
    color: var(--accent);
    margin-bottom: 20px;
    font-weight: 500;
  }
  .book-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  /* Life scenes — cinematic avatar panels */
  .life-scenes {
    max-width: 1100px;
    margin: 0 auto 64px;
    padding: 0 var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 80px;
  }
  .scene {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    opacity: 0;
  }
  .scene-right {
    direction: rtl;
  }
  .scene-right > * {
    direction: ltr;
  }
  .scene-image-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--bg-surface);
    border: 1px solid var(--border);
  }
  .scene-image-inner {
    position: absolute;
    inset: -20px;
  }
  .scene-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%) contrast(1.05);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .scene:hover .scene-image {
    transform: scale(1.03);
  }
  .scene-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(9, 9, 11, 0.4) 0%,
      transparent 40%,
      transparent 60%,
      rgba(9, 9, 11, 0.15) 100%
    );
    pointer-events: none;
  }
  .scene-content {
    padding: 20px 0;
  }
  .scene-number {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--accent);
    display: block;
    margin-bottom: 16px;
  }
  .scene-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 400;
    font-style: italic;
    color: var(--text-primary);
    margin-bottom: 16px;
  }
  .scene-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.8;
    max-width: 400px;
  }

  .beyond-note {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--text-secondary);
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
    padding: 32px 0;
    border-top: 1px solid var(--border);
    line-height: 1.8;
  }
  @media (max-width: 768px) {
    .book-section { grid-template-columns: 1fr; text-align: center; padding: 24px; }
    .book-cover-wrap { max-width: 240px; margin: 0 auto; }
    .life-scenes { gap: 48px; }
    .scene { grid-template-columns: 1fr; gap: 24px; }
    .scene-right { direction: ltr; }
    .scene-image-wrap { aspect-ratio: 3 / 4; max-width: 320px; margin: 0 auto; }
    .scene-content { text-align: center; padding: 0; }
    .scene-desc { max-width: 100%; margin: 0 auto; }
  }
</style>
