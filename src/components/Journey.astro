---
const milestones = [
  { year: 'Childhood', title: 'The First Question', desc: 'Wondered how a character moves in a video game. That curiosity changed everything.', accent: false, icon: 'gamepad' },
  { year: 'Class 8', title: 'First Game Built', desc: 'Built a simple graphic game. First time creating, not just consuming.', accent: true, icon: 'code' },
  { year: 'BTech', title: 'JIIT Noida', desc: 'Computer Science & Engineering. The curiosity became a degree.', accent: false, icon: 'graduation' },
  { year: '2021', title: 'Cognizant', desc: 'Programmer Analyst. Built a Python script that cut regression testing from 40 minutes to 90 seconds.', accent: false, icon: 'terminal' },
  { year: '2022', title: 'Tiger Analytics', desc: 'Data Analyst. Supply chain analytics across EMEA & North America. Reduced stock imbalance by 12–15%.', accent: false, icon: 'chart' },
  { year: 'MBA', title: 'BITS Pilani', desc: 'Business Analytics. Where engineering thinking met business strategy.', accent: true, icon: 'academic' },
  { year: '2023', title: 'AI Training', desc: 'Freelance AI Trainer at Outlier & Deccan AI. Evaluated and improved Large Language Models.', accent: false, icon: 'brain' },
  { year: '2024', title: 'Profit Plug', desc: 'Data & Marketing Analyst. Cut CAC by 28%, pushed CVR from 1.6% to 2.7%.', accent: false, icon: 'target' },
  { year: '2025', title: 'Arisva', desc: 'Founded a D2C incense brand. Built everything solo — brand, packaging, Meta ads. Peaked at ₹3.5L/month.', accent: true, icon: 'flame' },
  { year: '2026', title: 'Yovance', desc: 'Co-founded an AI growth & automation studio. Every lesson applied.', accent: true, icon: 'rocket' },
];

const icons: Record<string, string> = {
  gamepad: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="3"/><line x1="8" y1="10" x2="8" y2="14"/><line x1="6" y1="12" x2="10" y2="12"/><circle cx="16" cy="10" r="1" fill="currentColor"/><circle cx="18" cy="12" r="1" fill="currentColor"/></svg>',
  code: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/><line x1="14" y1="4" x2="10" y2="20"/></svg>',
  graduation: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10L12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1.66 2.69 3 6 3s6-1.34 6-3v-5"/><line x1="22" y1="10" x2="22" y2="16"/></svg>',
  terminal: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="6 10 10 14 6 18"/><line x1="14" y1="18" x2="18" y2="18"/></svg>',
  chart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><polyline points="7 16 11 11 15 14 21 7"/><polyline points="17 7 21 7 21 11"/></svg>',
  academic: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/><line x1="9" y1="7" x2="15" y2="7"/><line x1="9" y1="11" x2="13" y2="11"/></svg>',
  brain: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a5 5 0 00-4.77 3.5A4 4 0 004 9.5a4.5 4.5 0 001 8.5h2"/><path d="M12 2a5 5 0 014.77 3.5A4 4 0 0120 9.5a4.5 4.5 0 01-1 8.5h-2"/><line x1="12" y1="2" x2="12" y2="22"/><path d="M8 12h8"/><path d="M9 16h6"/></svg>',
  target: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/></svg>',
  flame: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c.5 3.5-1.5 6-1.5 6 1 1.5 3 3.5 3 6.5a4.5 4.5 0 01-9 0c0-2.5 1-4.5 2-6C8 6 6.5 3.5 6.5 3.5S11 5 12 2z"/><path d="M10 16.5a2 2 0 004 0c0-1.5-1-2.5-2-3.5-1 1-2 2-2 3.5z"/></svg>',
  rocket: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91-.79-.78-2.07-.79-2.91-.09z"/><path d="M12 15l-3-3"/><path d="M18 3s-4 .5-8 4.5L7 11l6 6 3.5-3c4-4 4.5-8 4.5-8z"/></svg>',
};
---
<section class="section journey" id="journey">
  <div class="container">
    <span class="section-label reveal">The Journey</span>
    <h2 class="section-title reveal stagger-1">From a video game<br/>to building companies</h2>
    <div class="divider reveal stagger-2"></div>
  </div>
  <div class="container timeline-container">
    <div class="timeline-line"></div>
    {milestones.map((m, i) => (
      <div class={`tl-item ${i % 2 === 0 ? 'tl-left' : 'tl-right'} ${m.accent ? 'tl-accent' : ''} reveal`}>
        <div class="tl-dot">
          <span class="tl-icon" set:html={icons[m.icon]} />
        </div>
        <div class="tl-card">
          <span class="tl-year">{m.year}</span>
          <h3 class="tl-title">{m.title}</h3>
          <p class="tl-desc">{m.desc}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .journey { padding-bottom: 80px; }
  .timeline-container {
    position: relative;
    padding-top: 20px;
  }
  .timeline-line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, transparent, var(--accent) 10%, var(--accent) 90%, transparent);
    transform: translateX(-50%);
  }
  .tl-item {
    display: flex;
    align-items: flex-start;
    position: relative;
    margin-bottom: 40px;
    width: 50%;
  }
  .tl-left {
    padding-right: 48px;
    justify-content: flex-end;
  }
  .tl-right {
    margin-left: 50%;
    padding-left: 48px;
  }
  .tl-dot {
    position: absolute;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg-elevated);
    border: 1px solid var(--border-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }
  .tl-left .tl-dot {
    right: -20px;
  }
  .tl-right .tl-dot {
    left: -20px;
  }
  .tl-icon {
    width: 18px;
    height: 18px;
    color: var(--accent);
    display: flex;
  }
  .tl-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .tl-card {
    padding: 24px 28px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 16px;
    max-width: 380px;
    transition: border-color 0.3s, transform 0.3s;
  }
  .tl-card:hover {
    border-color: var(--border-accent);
    transform: translateY(-3px);
  }
  .tl-accent .tl-card {
    border-color: var(--border-accent);
    background: linear-gradient(135deg, var(--bg-elevated) 0%, rgba(212, 168, 83, 0.04) 100%);
  }
  .tl-accent .tl-dot {
    background: var(--accent);
    border-color: var(--accent);
  }
  .tl-accent .tl-icon {
    color: var(--bg-deep);
  }
  .tl-year {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
    margin-bottom: 8px;
  }
  .tl-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }
  .tl-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  @media (max-width: 768px) {
    .timeline-line { left: 20px; }
    .tl-item { width: 100%; padding-left: 56px !important; padding-right: 0 !important; margin-left: 0 !important; }
    .tl-left, .tl-right { justify-content: flex-start; }
    .tl-dot { left: 0 !important; right: auto !important; }
    .tl-card { max-width: 100%; }
  }
</style>
