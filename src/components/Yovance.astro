---
const pillars = [
  { name: 'Grow', accent: '#6C33FF', desc: 'AI Search Visibility, Local SEO, Founder Brand on LinkedIn, Webinar Engine.', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>' },
  { name: 'Automate', accent: '#10D9A0', desc: 'Content Engine, Marketing Automation, Conversion Websites, Custom Platform Builds.', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>' },
  { name: 'Decide', accent: '#4A9EFF', desc: 'Decision Intelligence, Margin & Spend Analysis, Demand Forecasting, Operations Analytics.', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>' },
];
---
<section class="section yovance" id="yovance">
  <div class="container">
    <span class="section-label reveal">What I'm Building Now</span>
    <h2 class="section-title reveal stagger-1">Yovance</h2>
    <p class="section-subtitle reveal stagger-2">
      An AI growth & automation studio for owner-led businesses.
      One partner instead of five vendors — SEO, content, automation, and data
      that actually talk to each other. Co-founded with
      <strong>Harshita Sevaldasani</strong>.
    </p>
    <div class="divider reveal stagger-3"></div>

    <div class="yovance-grid">
      {pillars.map((p, i) => (
        <div class={`pillar-card reveal stagger-${i + 1}`}>
          <div class="pillar-icon" style={`color: ${p.accent}`} set:html={p.icon} />
          <h3 class="pillar-name">{p.name}</h3>
          <p class="pillar-desc">{p.desc}</p>
        </div>
      ))}
    </div>

    <div class="yovance-details reveal">
      <div class="detail-item">
        <span class="detail-label">Model</span>
        <span class="detail-value">Two founders, no juniors. Clients work directly with us.</span>
      </div>
      <div class="detail-item">
        <span class="detail-label">Guarantee</span>
        <span class="detail-value">Measurable 90-day milestones. Miss them, we work free until hit.</span>
      </div>
      <div class="detail-item">
        <span class="detail-label">My role</span>
        <span class="detail-value">Co-founder — Data, Automation & Technical Strategy.</span>
      </div>
    </div>

    <a href="https://yovance.pro" target="_blank" rel="noopener" class="yovance-link reveal">
      Visit yovance.pro
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</section>

<style>
  .yovance {
    background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-elevated) 50%, var(--bg-deep) 100%);
  }
  .yovance-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 48px;
  }
  .pillar-card {
    padding: 32px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    transition: border-color 0.3s, transform 0.3s;
  }
  .pillar-card:hover {
    border-color: var(--border-accent);
    transform: translateY(-4px);
  }
  .pillar-icon {
    width: 32px;
    height: 32px;
    margin-bottom: 16px;
  }
  .pillar-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .pillar-name {
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: 12px;
    color: var(--text-primary);
  }
  .pillar-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .yovance-details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 32px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    margin-bottom: 32px;
  }
  .detail-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .detail-value {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .yovance-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 1rem;
    color: var(--accent);
    transition: gap 0.2s;
  }
  .yovance-link:hover { gap: 12px; color: var(--accent-hover); }
  @media (max-width: 768px) {
    .yovance-grid { grid-template-columns: 1fr; }
    .yovance-details { grid-template-columns: 1fr; }
  }
</style>
